{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: title bar controls and the account commands.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-accounts-list",
    "allow-account-switch",
    "allow-account-remove",
    "allow-account-refresh",
    "allow-account-head",
    "allow-auth-login-start",
    "allow-auth-login-cancel",
    "allow-auth-open-verification"
  ]
}
